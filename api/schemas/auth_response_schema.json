{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["Token", "Validations", "Warnings", "IsValid"],
  "properties": {
    "Token": {
      "type": ["string", "null"]
    },
    "Validations": {
      "type": "object",
      "properties": {
        "UserName": {
          "type": "object",
          "required": ["Message"],
          "properties": {
            "Message": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "Warnings": {
      "type": "object"
    },
    "IsValid": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
